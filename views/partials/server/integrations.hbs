<div class="grid gap-4 lg:grid-cols-2" id="ig-root" data-server-id="{{server.id}}" data-invite="{{json integrations.invite}}">

  <div class="card p-4 lg:col-span-2" id="ig-bot-root" data-server-id="{{server.id}}" data-admin="{{#if (eq user.role 'admin')}}1{{else}}0{{/if}}">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
      <div>
        <h3 class="flex items-center gap-2 font-semibold">{{{icon 'bot' 'size-4 text-link'}}} Discord bot</h3>
        <p class="mt-1 text-xs text-ink-faint">One panel-wide bot. This server owns the channel binding; global credentials and command roles are shared by every server.</p>
      </div>
      <div class="flex items-center gap-2 rounded-md border border-line bg-inset px-2.5 py-1.5" data-bot-connection aria-live="polite">
        <span class="status-dot relative {{#if integrations.discordBot.bot.running}}bg-grass-500{{else}}bg-stone-500{{/if}}" data-bot-status-dot></span>
        <div class="text-right leading-tight">
          <p class="text-xs font-semibold {{#if integrations.discordBot.bot.running}}text-ok{{else}}text-ink-faint{{/if}}" data-bot-status>{{#if integrations.discordBot.bot.running}}Bot running{{else}}Bot stopped{{/if}}</p>
          <p class="mt-0.5 text-[11px] text-ink-faint" data-bot-status-detail>{{#if integrations.discordBot.bot.running}}Discord Gateway connected{{else}}Commands and relay are offline{{/if}}</p>
        </div>
      </div>
    </div>

    <div class="grid gap-4 xl:grid-cols-3">
      <div class="space-y-3">
        <h4 class="text-sm font-semibold">Global bot setup</h4>
        <div>
          <label class="label" for="ig-bot-token">Bot token</label>
          <input class="input font-mono text-xs" type="password" id="ig-bot-token" autocomplete="off" placeholder="Paste a new token, or leave blank to keep it" {{#unless (eq user.role 'admin')}}disabled{{/unless}}>
          {{#if integrations.discordBot.bot.hasToken}}<p class="help">Stored: <code class="rounded bg-inset px-1 font-mono">{{integrations.discordBot.bot.tokenMasked}}</code></p>{{else}}<p class="help">Stored encrypted; never returned in full.</p>{{/if}}
        </div>
        <div>
          <label class="label" for="ig-bot-guild">Guild ID</label>
          <input class="input font-mono text-xs" id="ig-bot-guild" value="{{integrations.discordBot.bot.guildId}}" maxlength="21" {{unless (eq user.role 'admin') 'disabled'}}>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div><label class="label" for="ig-bot-admin-role">Admin role ID</label><input class="input font-mono text-xs" id="ig-bot-admin-role" value="{{integrations.discordBot.bot.adminRoleId}}" maxlength="21" {{unless (eq user.role 'admin') 'disabled'}}></div>
          <div><label class="label" for="ig-bot-mod-role">Moderator role ID</label><input class="input font-mono text-xs" id="ig-bot-mod-role" value="{{integrations.discordBot.bot.modRoleId}}" maxlength="21" {{unless (eq user.role 'admin') 'disabled'}}></div>
        </div>
        <label class="flex items-center justify-between gap-3 text-sm"><span>Start bot automatically with the panel</span><span class="msm-toggle"><input type="checkbox" id="ig-bot-autostart" {{#if integrations.discordBot.bot.autoStart}}checked{{/if}} {{unless (eq user.role 'admin') 'disabled'}}><span></span></span></label>
        <div class="flex flex-wrap gap-2">
          <button class="btn" id="ig-bot-verify" {{unless (eq user.role 'admin') 'disabled'}}>Verify token</button>
          <button class="btn btn-primary" id="ig-bot-save-global" {{unless (eq user.role 'admin') 'disabled'}}>Save global setup</button>
        </div>
      </div>

      <div class="space-y-3">
        <h4 class="text-sm font-semibold">This server's channel binding</h4>
        <label class="flex items-center justify-between gap-3 text-sm"><span>Enable bot for this server</span><span class="msm-toggle"><input type="checkbox" id="ig-bot-enabled" {{#if integrations.discordBot.binding.enabled}}checked{{/if}} {{unless (eq user.role 'admin') 'disabled'}}><span></span></span></label>
        <div><label class="label" for="ig-bot-channel">Command / notification channel ID</label><input class="input font-mono text-xs" id="ig-bot-channel" value="{{integrations.discordBot.binding.channelId}}" maxlength="21" {{unless (eq user.role 'admin') 'disabled'}}></div>
        <label class="flex items-center justify-between gap-3 text-sm"><span>Enable two-way chat relay</span><span class="msm-toggle"><input type="checkbox" id="ig-bot-relay-enabled" {{#if integrations.discordBot.binding.relayEnabled}}checked{{/if}} {{unless (eq user.role 'admin') 'disabled'}}><span></span></span></label>
        <div><label class="label" for="ig-bot-relay-channel">Optional relay channel ID</label><input class="input font-mono text-xs" id="ig-bot-relay-channel" value="{{integrations.discordBot.binding.relayChannelId}}" maxlength="21" placeholder="Blank = use command channel" {{unless (eq user.role 'admin') 'disabled'}}></div>
        <div class="flex flex-wrap gap-2">
          <button class="btn btn-primary" id="ig-bot-save-binding" {{unless (eq user.role 'admin') 'disabled'}}>Save binding</button>
          <button class="btn" id="ig-bot-test" {{unless (eq user.role 'admin') 'disabled'}}>Send test</button>
          <button class="btn btn-primary" id="ig-bot-start" {{unless (eq user.role 'admin') 'disabled'}}>Start bot</button>
          <button class="btn" id="ig-bot-stop" {{unless (eq user.role 'admin') 'disabled'}}>Stop bot</button>
          <button class="btn btn-danger" id="ig-bot-reset" {{unless (eq user.role 'admin') 'disabled'}}>Reset all bot config</button>
        </div>
      </div>

      <div class="space-y-3">
        <h4 class="text-sm font-semibold">Global command permissions</h4>
        <p class="help">These tiers apply to every server and are enforced inside Discord.</p>
        <div class="grid grid-cols-2 gap-2 text-xs" data-bot-permissions>
          <label>Status <select class="input" data-bot-permission="status" {{unless (eq user.role 'admin') 'disabled'}}><option value="everyone">everyone</option><option value="moderator">moderator</option><option value="admin">admin</option></select></label>
          <label>Players <select class="input" data-bot-permission="players" {{unless (eq user.role 'admin') 'disabled'}}><option value="everyone">everyone</option><option value="moderator">moderator</option><option value="admin">admin</option></select></label>
          <label>Save <select class="input" data-bot-permission="save" {{unless (eq user.role 'admin') 'disabled'}}><option value="everyone">everyone</option><option value="moderator">moderator</option><option value="admin">admin</option></select></label>
          <label>Broadcast <select class="input" data-bot-permission="broadcast" {{unless (eq user.role 'admin') 'disabled'}}><option value="everyone">everyone</option><option value="moderator">moderator</option><option value="admin">admin</option></select></label>
          <label>Kick <select class="input" data-bot-permission="kick" {{unless (eq user.role 'admin') 'disabled'}}><option value="everyone">everyone</option><option value="moderator">moderator</option><option value="admin">admin</option></select></label>
          <label>Start <select class="input" data-bot-permission="start" {{unless (eq user.role 'admin') 'disabled'}}><option value="everyone">everyone</option><option value="moderator">moderator</option><option value="admin">admin</option></select></label>
          <label>Stop <select class="input" data-bot-permission="stop" {{unless (eq user.role 'admin') 'disabled'}}><option value="everyone">everyone</option><option value="moderator">moderator</option><option value="admin">admin</option></select></label>
          <label>Restart <select class="input" data-bot-permission="restart" {{unless (eq user.role 'admin') 'disabled'}}><option value="everyone">everyone</option><option value="moderator">moderator</option><option value="admin">admin</option></select></label>
          <label>RCON <select class="input" data-bot-permission="rcon" {{unless (eq user.role 'admin') 'disabled'}}><option value="everyone">everyone</option><option value="moderator">moderator</option><option value="admin">admin</option></select></label>
        </div>
        <button class="btn btn-primary" id="ig-bot-save-permissions" {{unless (eq user.role 'admin') 'disabled'}}>Save permissions</button>
      </div>
    </div>

    <details class="mt-5 rounded-md border border-line bg-raised p-3" {{#if integrations.discordBot.binding.enabled}}open{{/if}}>
      <summary class="cursor-pointer text-sm font-semibold">Event notification templates</summary>
      <p class="help mt-2">Templates are per server. Variables: <code>{server}</code>, <code>{player}</code>, <code>{minutes}</code>, <code>{message}</code>, and <code>{killer}</code>. Mentions are always disabled.</p>
      <div class="mt-3 grid gap-3 lg:grid-cols-2">
        <label class="text-xs"><span class="flex items-center justify-between gap-2"><span>Server start</span><span class="msm-toggle"><input type="checkbox" data-bot-event="serverStart" {{#if integrations.discordBot.binding.events.serverStart.enabled}}checked{{/if}} {{unless (eq user.role 'admin') 'disabled'}}><span></span></span></span><input class="input mt-1 text-xs" data-bot-template="serverStart" value="{{integrations.discordBot.binding.events.serverStart.template}}" {{unless (eq user.role 'admin') 'disabled'}}></label>
        <label class="text-xs"><span class="flex items-center justify-between gap-2"><span>Server stop</span><span class="msm-toggle"><input type="checkbox" data-bot-event="serverStop" {{#if integrations.discordBot.binding.events.serverStop.enabled}}checked{{/if}} {{unless (eq user.role 'admin') 'disabled'}}><span></span></span></span><input class="input mt-1 text-xs" data-bot-template="serverStop" value="{{integrations.discordBot.binding.events.serverStop.template}}" {{unless (eq user.role 'admin') 'disabled'}}></label>
        <label class="text-xs"><span class="flex items-center justify-between gap-2"><span>Player join</span><span class="msm-toggle"><input type="checkbox" data-bot-event="playerJoin" {{#if integrations.discordBot.binding.events.playerJoin.enabled}}checked{{/if}} {{unless (eq user.role 'admin') 'disabled'}}><span></span></span></span><input class="input mt-1 text-xs" data-bot-template="playerJoin" value="{{integrations.discordBot.binding.events.playerJoin.template}}" {{unless (eq user.role 'admin') 'disabled'}}></label>
        <label class="text-xs"><span class="flex items-center justify-between gap-2"><span>Player leave</span><span class="msm-toggle"><input type="checkbox" data-bot-event="playerLeave" {{#if integrations.discordBot.binding.events.playerLeave.enabled}}checked{{/if}} {{unless (eq user.role 'admin') 'disabled'}}><span></span></span></span><input class="input mt-1 text-xs" data-bot-template="playerLeave" value="{{integrations.discordBot.binding.events.playerLeave.template}}" {{unless (eq user.role 'admin') 'disabled'}}></label>
        <label class="text-xs"><span class="flex items-center justify-between gap-2"><span>Player death</span><span class="msm-toggle"><input type="checkbox" data-bot-event="playerDeath" {{#if integrations.discordBot.binding.events.playerDeath.enabled}}checked{{/if}} {{unless (eq user.role 'admin') 'disabled'}}><span></span></span></span><input class="input mt-1 text-xs" data-bot-template="playerDeath" value="{{integrations.discordBot.binding.events.playerDeath.template}}" {{unless (eq user.role 'admin') 'disabled'}}></label>
        <label class="text-xs"><span class="flex items-center justify-between gap-2"><span>Restart warning</span><span class="msm-toggle"><input type="checkbox" data-bot-event="scheduledRestart" {{#if integrations.discordBot.binding.events.scheduledRestart.enabled}}checked{{/if}} {{unless (eq user.role 'admin') 'disabled'}}><span></span></span></span><input class="input mt-1 text-xs" data-bot-template="scheduledRestart" value="{{integrations.discordBot.binding.events.scheduledRestart.template}}" {{unless (eq user.role 'admin') 'disabled'}}></label>
        <label class="text-xs"><span class="flex items-center justify-between gap-2"><span>Backup complete</span><span class="msm-toggle"><input type="checkbox" data-bot-event="backupComplete" {{#if integrations.discordBot.binding.events.backupComplete.enabled}}checked{{/if}} {{unless (eq user.role 'admin') 'disabled'}}><span></span></span></span><input class="input mt-1 text-xs" data-bot-template="backupComplete" value="{{integrations.discordBot.binding.events.backupComplete.template}}" {{unless (eq user.role 'admin') 'disabled'}}></label>
      </div>
      <button class="btn btn-primary mt-3" id="ig-bot-save-events" {{unless (eq user.role 'admin') 'disabled'}}>Save event templates</button>
    </details>
  </div>

  <div class="card p-4">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h3 class="flex items-center gap-2 font-semibold">{{{icon 'webhook' 'size-4 text-link'}}} Discord notifications</h3>
      <span class="msm-toggle"><input type="checkbox" id="ig-dc-enabled" {{#if integrations.discord.enabled}}checked{{/if}}><span></span></span>
    </div>
    <div class="space-y-4">
      <div>
        <label class="label" for="ig-dc-url">Webhook URL</label>
        <input class="input font-mono text-xs" type="password" id="ig-dc-url" autocomplete="off" placeholder="https://discord.com/api/webhooks/…">
        {{! The stored webhook is shown as a fact, not a placeholder — a
            placeholder disappears on focus and reads as example text. }}
        {{#if integrations.discord.hasWebhook}}
          <p class="help">Stored: <code class="rounded bg-inset px-1 font-mono">{{integrations.discord.webhookMasked}}</code> — leave blank to keep it, paste a new URL to replace it.</p>
        {{else}}
          <p class="help">Server Settings → Integrations → Webhooks in your Discord server. Stored encrypted.</p>
        {{/if}}
      </div>
      <div>
        <span class="label">Send notifications for</span>
        <div class="grid grid-cols-2 gap-2 text-sm sm:grid-cols-3">
          <label class="flex items-center gap-2"><input type="checkbox" class="msm-check" data-dc-event="lifecycle" {{#if integrations.discord.events.lifecycle}}checked{{/if}}> Start / stop</label>
          <label class="flex items-center gap-2"><input type="checkbox" class="msm-check" data-dc-event="crashes" {{#if integrations.discord.events.crashes}}checked{{/if}}> Crashes</label>
          <label class="flex items-center gap-2"><input type="checkbox" class="msm-check" data-dc-event="backups" {{#if integrations.discord.events.backups}}checked{{/if}}> Backups</label>
          <label class="flex items-center gap-2"><input type="checkbox" class="msm-check" data-dc-event="updates" {{#if integrations.discord.events.updates}}checked{{/if}}> Updates</label>
          <label class="flex items-center gap-2"><input type="checkbox" class="msm-check" data-dc-event="players" {{#if integrations.discord.events.players}}checked{{/if}}> Kicks / bans</label>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button class="btn btn-primary" id="ig-dc-save">Save</button>
        {{#if integrations.discord.hasWebhook}}
          <button class="btn" id="ig-dc-test">{{{icon 'send' 'size-4'}}} Send test</button>
        {{else}}
          {{! Disabled controls swallow hover — the wrapper carries the "why". }}
          <span data-tip="Save a webhook URL first"><button class="btn" id="ig-dc-test" disabled>{{{icon 'send' 'size-4'}}} Send test</button></span>
        {{/if}}
        <span class="hidden text-xs text-warn" data-ig-dirty="dc">Unsaved changes</span>
      </div>
    </div>
  </div>

  <div class="card p-4">
    <div class="mb-4 flex items-center justify-between gap-3">
      <h3 class="flex items-center gap-2 font-semibold">{{{icon 'globe' 'size-4 text-ok'}}} Public status page</h3>
      <span class="msm-toggle"><input type="checkbox" id="ig-sp-enabled" {{#if integrations.statusPage.enabled}}checked{{/if}}><span></span></span>
    </div>
    <div class="space-y-4">
      <div>
        <label class="label" for="ig-sp-slug">Page address</label>
        <div class="flex items-center gap-2">
          <span class="font-mono text-xs text-ink-faint">/status/</span>
          <input class="input flex-1 font-mono text-xs" id="ig-sp-slug" placeholder="my-server" value="{{integrations.statusPage.slug}}">
        </div>
        <p class="help">Anyone with the link sees name, MOTD, version, player count, and uptime — nothing else, and no way into the panel. Off by default.</p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button class="btn btn-primary" id="ig-sp-save">Save</button>
        {{#if (and integrations.statusPage.enabled integrations.statusPage.path)}}
          <a class="btn" href="{{integrations.statusPage.path}}" target="_blank" rel="noopener" id="ig-sp-link">{{{icon 'link' 'size-4'}}} Open page</a>
          <button class="btn btn-ghost" id="ig-sp-copy">{{{icon 'copy' 'size-4'}}} Copy link</button>
        {{/if}}
        <span class="hidden text-xs text-warn" data-ig-dirty="sp">Unsaved changes</span>
      </div>
    </div>
  </div>

  <div class="card p-4 lg:col-span-2">
    <h3 class="mb-4 flex items-center gap-2 font-semibold">{{{icon 'send' 'size-4 text-warn'}}} Invite friends</h3>
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="space-y-4">
        <div>
          <label class="label" for="ig-addr">Address to share</label>
          <select class="input" id="ig-addr" data-label="Address to share">
            {{#each integrations.invite.candidates}}
              <option value="{{this}}" data-desc="Local network (LAN)">{{this}}</option>
            {{/each}}
            {{#if integrations.invite.publicAddress}}
              <option value="{{integrations.invite.publicAddress}}" data-desc="Public IP — needs port forwarding">{{integrations.invite.publicAddress}}</option>
            {{/if}}
            <option value="__custom" data-desc="Domain or address you set up yourself">Custom address…</option>
          </select>
          <input class="input mt-2 hidden font-mono text-xs" id="ig-host" placeholder="play.example.com:{{integrations.invite.port}}">
        </div>
        <div>
          <span class="label">Invite text</span>
          <pre class="max-h-44 overflow-auto whitespace-pre-wrap rounded-md border border-line bg-inset p-3 font-mono text-xs text-ink-soft" id="ig-invite-text">{{integrations.invite.inviteText}}</pre>
        </div>
        <div class="flex flex-wrap gap-2">
          <button class="btn btn-primary" id="ig-copy-invite">{{{icon 'copy' 'size-4'}}} Copy invite text</button>
          {{#if integrations.invite.modded}}
            <button class="btn" id="ig-mrpack">{{{icon 'download' 'size-4'}}} Download client modpack (.mrpack)</button>
          {{/if}}
        </div>
      </div>
      <div class="space-y-3 text-sm">
        {{#if integrations.invite.modded}}
          <div class="rounded-md border border-line bg-raised p-3">
            <p class="font-medium">{{{icon 'shield' 'size-3.5'}}} What friends need</p>
            <p class="mt-1 text-xs text-ink-soft">Import the .mrpack into Prism Launcher or the Modrinth App — it installs the right Minecraft version, the mods, and pre-adds this server to their multiplayer list.</p>
            {{#if integrations.invite.manualMods.length}}
              <p class="mt-2 text-xs text-warn">These mods are not on Modrinth, so friends must add the files to their <code class="rounded bg-inset px-1">mods</code> folder themselves:</p>
              <ul class="mt-1 list-inside list-disc text-xs text-ink-soft">
                {{#each integrations.invite.manualMods}}<li>{{name}} <span class="font-mono text-ink-faint">({{filename}})</span></li>{{/each}}
              </ul>
            {{/if}}
          </div>
        {{else}}
          <div class="rounded-md border border-line bg-raised p-3">
            <p class="font-medium">{{{icon 'shield' 'size-3.5'}}} What friends need</p>
            <p class="mt-1 text-xs text-ink-soft">Just vanilla Minecraft {{integrations.invite.mcVersion}} — no mods required on the client.</p>
          </div>
        {{/if}}
        {{#if integrations.invite.whitelistEnforced}}
          <div class="notice notice-warn text-xs text-warn">Whitelist is enforced — add each friend on the Players tab before they join.</div>
        {{/if}}
        <details class="rounded-md border border-line bg-raised p-3 text-xs">
          <summary class="cursor-pointer font-medium text-sm">Playing over the internet (port forwarding)</summary>
          <p class="mt-2 text-ink-soft">{{integrations.invite.portForwardGuidance}}</p>
          {{#if integrations.invite.publicIp}}
            <p class="mt-2">Detected public IP: <code class="rounded bg-inset px-1 font-mono">{{integrations.invite.publicIp}}</code></p>
          {{else}}
            <p class="mt-2 text-ink-faint">Public IP could not be detected right now (offline?).</p>
          {{/if}}
        </details>
      </div>
    </div>
  </div>
</div>

<script type="module" src="/js/pages/integrations.js"></script>
<script type="module" src="/js/pages/discord-bot.js"></script>
